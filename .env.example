# Telegram Serverless CLI access token (used by CI/CD or `npx tgcloud login`)
# Get it in @BotFather -> Your Bot -> Serverless -> CLI Access -> Access token
# Format: app<id>:<secret>
# Note: Bot API token (TELEGRAM_BOT_API) is NOT needed in Telegram Serverless code.
TGCLOUD_TOKEN=

# LLM providers (at least one key is required for AI answers)
OPENROUTER_API=
GEMINI_API=

# Optional model overrides
OPENROUTER_MODEL=deepseek/deepseek-chat
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional bot identity cache (skips cold-start api.getMe() call if set)
# BOT_ID=
# BOT_USERNAME=

# Optional comma-separated list of allowed Telegram chat IDs (empty = allow all)
# ALLOWED_CHAT_IDS=-1001234567890,-1009876543210

# Optional Telegram user ID(s) with admin access to /prompt, /setprompt, /resetprompt
# Find your Telegram ID by sending /id to the bot in private chat
# OWNER_ID=123456789
# ADMIN_USER_IDS=123456789,987654321

# Optional custom system prompt (leave commented to use default "Подсолнух" prompt)
# SYSTEM_PROMPT=

# Optional reply-branch memory limits (defaults keep token usage low on free tiers)
# BRANCH_MAX_DEPTH=8
# BRANCH_MAX_CONTEXT_CHARS=6000